{
    "name": "teamsfx-template-api",
    "version": "1.0.0",
    "engines": {
        "node": "18 || 20 || 22 || 24"
    },
    "main": "dist/src/functions/*.js",
    "scripts": {
        "dev:teamsfx": "echo Node path: $(which node) && node -v && env-cmd --silent -f .localConfigs npm run dev",
        "dev": "func start --typescript --language-worker=\"--inspect=9229\" --port \"7071\" --cors \"*\"",
        "build": "tsc",
        "watch:teamsfx": "tsc -w",
        "clean": "rimraf dist",
        "prestart": "npm run clean && npm run build",
        "start": "npx func start",
        "test": "echo \"Error: no test specified\" && exit 1",
        "_comment_db": "Database deployment scripts",
        "deploy:databases": "npm run build && node dist/src/scripts/deploy-databases.js",
        "deploy:sql": "npm run build && node dist/src/scripts/deploy-sql-migrations.js",
        "deploy:cosmos": "npm run build && node dist/src/scripts/init-cosmos-db.js",
        "validate:databases": "npm run deploy:databases -- --validate-only",
        "db:health": "npm run build && node -e \"require('./dist/src/scripts/deploy-sql-migrations.js').checkDatabaseHealth().then(r => console.log('Health:', r ? 'OK' : 'FAILED'))\"",
        "_comment_dev": "Development helpers",
        "db:setup-local": "echo 'Setting up local databases...' && echo 'Make sure you have SQL Server and Cosmos DB Emulator running'"
    },
    "dependencies": {
        "@azure/cosmos": "^4.2.0",
        "@azure/functions": "^4.0.0",
        "@microsoft/microsoft-graph-client": "^3.0.7",
        "@microsoft/microsoft-graph-types": "^2.40.0",
        "@microsoft/teamsfx": "^3.0.0",
        "isomorphic-fetch": "^3.0.0",
        "mssql": "^10.0.2",
        "zod": "^3.23.8"
    },
    "optionalDependencies": {
        "@types/mssql": "^9.0.0"
    },
    "devDependencies": {
        "@types/node": "^18.x",
        "env-cmd": "^10.1.0",
        "rimraf": "^5.0.0",
        "typescript": "^4.4.4"
    }
}
