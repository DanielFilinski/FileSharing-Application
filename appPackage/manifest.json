{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.21/MicrosoftTeams.schema.json",
    "manifestVersion": "1.21",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "FileSharing Application",
        "websiteUrl": "${{TAB_ENDPOINT}}",
        "privacyUrl": "${{TAB_ENDPOINT}}/index.html#/privacy",
        "termsOfUseUrl": "${{TAB_ENDPOINT}}/index.html#/terms"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "FileSharing${{APP_NAME_SUFFIX}}",
        "full": "Document Management & SharePoint Integration"
    },
    "description": {
        "short": "Complete document lifecycle management for organizations",
        "full": "Professional document management system with SharePoint integration, End User context, and comprehensive workflow automation for Microsoft Teams"
    },
    "accentColor": "#0078D4",
    "bots": [],
    "composeExtensions": [],
    "configurableTabs": [
        {
            "configurationUrl": "${{TAB_ENDPOINT}}/index.html#/teams/config",
            "canUpdateConfiguration": true,
            "scopes": [
                "team",
                "groupChat"
            ]
        }
    ],
    "staticTabs": [
        {
            "entityId": "documents-tab",
            "name": "Documents",
            "contentUrl": "${{TAB_ENDPOINT}}/index.html#/teams/tab",
            "websiteUrl": "${{TAB_ENDPOINT}}/index.html#/teams/tab",
            "scopes": [
                "personal",
                "groupChat", 
                "team"
            ]
        },
        {
            "entityId": "sharepoint-tab",
            "name": "SharePoint",
            "contentUrl": "${{TAB_ENDPOINT}}/index.html#/teams/sharepoint",
            "websiteUrl": "${{TAB_ENDPOINT}}/index.html#/sharepoint",
            "scopes": [
                "personal",
                "team"
            ]
        }
    ],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "${{TAB_HOSTNAME}}",
        "*.sharepoint.com",
        "*.office.com"
    ],
    "webApplicationInfo": {
        "id": "${{AAD_APP_CLIENT_ID}}",
        "resource": "api://${{TAB_DOMAIN}}/${{AAD_APP_CLIENT_ID}}"
    },
    "activities": {
        "activityTypes": [
            {
                "type": "documentShared",
                "description": "Document was shared",
                "templateText": "{actor} shared document {documentName}"
            },
            {
                "type": "documentUploaded", 
                "description": "New document uploaded",
                "templateText": "{actor} uploaded {documentName}"
            },
            {
                "type": "approvalNeeded",
                "description": "Document needs approval",
                "templateText": "{documentName} requires approval"
            }
        ]
    }
}